# SPB-007 — Política institucional de finales de línea
* text=auto

*.py      text eol=lf
*.ps1     text eol=crlf
*.psm1    text eol=crlf
*.psd1    text eol=crlf
*.md      text eol=lf
*.json    text eol=lf
*.jsonl   text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.toml    text eol=lf
*.ini     text eol=lf
*.sql     text eol=lf
*.sh      text eol=lf

*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.pdf     binary
*.xlsx    binary
*.zip     binary
*.sqlite3 binary
*.db      binary
*.wav     binary
*.mp3     binary
*.mp4     binary