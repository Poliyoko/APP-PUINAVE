                                            "enabled":  true,
                                            "order":  3,
                                            "content_availability":  "PENDING_CONTENT"
                                        },
                                        {
                                            "code":  "pt",
                                            "name":  "Português",
                                            "enabled":  true,
                                            "order":  4,
                                            "content_availability":  "PENDING_CONTENT"
                                        }
                                    ],
                      "rules":  {
                                    "no_hardcoded_auxiliary_limit":  true,
                                    "configured_does_not_mean_content_exists":  true,
