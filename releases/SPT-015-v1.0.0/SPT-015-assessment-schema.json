{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SPT-015 Assessment Item",
  "type": "object",
  "required": [
    "item_id",
    "entry_id",
    "competency",
    "assessment_type",
    "difficulty",
    "prompt",
    "correct_answer"
  ],
  "properties": {
    "item_id": {
      "type": "string",
      "pattern": "^QST-"
    },
    "entry_id": {
      "type": "string",
      "pattern": "^LEX-"
    },
    "assessment_type": {
      "enum": [
        "diagnostic",
        "formative",
        "summative"
      ]
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "validated": {
      "type": "boolean"
    }
  }
}